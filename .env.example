PORT=3000
# Comma-separated browser origins allowed to call the API when the client is hosted separately.
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_MINUTES=60
GAME_DURATION_MS=60000
FUNDRAISING_TARGET_PENCE=100000
DONATION_IMPACT_MESSAGE=Every donation helps Santa's Cause give local children presents this Christmas.
# Matching is disabled unless a genuine sponsor name is configured.
SPONSOR_NAME=
SPONSOR_MATCH_RATE=1
SPONSOR_MATCH_LIMIT_PENCE=0
# Enables the otherwise-hidden GET /api/admin/analytics report.
ANALYTICS_ADMIN_TOKEN=

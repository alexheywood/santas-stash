{
  "name": "santas-stash",
  "version": "1.0.0",
  "private": true,
  "description": "Santa's Stash geography game",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node --check server/index.js && node --check server/index.test.js && node --test --test-isolation=none server/index.test.js && vite build",
    "test": "node --test --test-isolation=none server/index.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@2toad/profanity": "^3.3.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.7"
  }
}
